# Copy to .env for local runs. In GitHub Actions these come from repo secrets.
APPLICANT_NAME=Jane Doe
APPLICANT_EMAIL=you@example.com
APPLICANT_PHONE=+1 555 555 5555
APPLICANT_LINKEDIN=
APPLICANT_GITHUB=
SLACK_WEBHOOK_URL=
# true = fill forms but never submit (default). Set false to actually apply.
DRY_RUN=true
# Smallest file accepted as a real resume.pdf. Guards against submitting an empty
# file, a placeholder stub, or a truncated download to real employers.
MIN_RESUME_BYTES=4096
# Applications actually submitted per run.
MAX_APPLICATIONS_PER_RUN=10
# Jobs examined per run while trying to fill that quota (skips and manual-review
# hand-offs cost an examination, not an application).
MAX_JOBS_EXAMINED_PER_RUN=60
# Skip postings whose compatibility score (0-100, see src/score.js) is below this.
# 0 disables the gate. Scores are computed against assets/profile.json — edit that
# first, watch a dry run's scores, and only then raise this.
MIN_COMPATIBILITY=0
# Indeed is behind Cloudflare and usually blocked from CI — off by default.
ENABLE_INDEED=false
