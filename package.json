{
  "name": "jobify",
  "version": "0.1.0",
  "description": "Auto-apply to Summer 2027 software internships/entry-level roles. Scrapes Indeed + GitHub boards, applies with Playwright, tracks state, notifies Slack.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dry-run": "DRY_RUN=true node src/index.js",
    "dashboard": "node scripts/serve-dashboard.js",
    "explain-resume": "node scripts/explain-resume.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "playwright": "^1.45.0"
  }
}
